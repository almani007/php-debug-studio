{
    "name": "zoventra/php-debug-studio-core",
    "description": "Framework-neutral core SDK for PHP Debug Studio by zoventra",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "zoventra",
            "email": "dev@zoventra.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Zoventra\\DebugStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoventra\\DebugStudio\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
