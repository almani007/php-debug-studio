{
    "name": "brixel/php-debug-studio-laravel",
    "description": "Laravel integration adapter for PHP Debug Studio by brixel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "brixel",
            "email": "dev@brixel.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "brixel/php-debug-studio-core": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Brixel\\DebugStudio\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Brixel\\DebugStudio\\Laravel\\DebugStudioServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
