{
  "name": "php-debug-studio",
  "private": true,
  "description": "PHP Debug Studio by zoventra - Monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:desktop": "npm --prefix apps/desktop run tauri dev",
    "daemon": "cd apps/daemon && go run main.go"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
